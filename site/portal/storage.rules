rules_version = '2';
// Arquivos dos clientes (manual, posts, artes): leitura pelo link, envio só pelo admin.
service firebase.storage {
  match /b/{bucket}/o {
    match /cronograma/{rest=**} {
      allow read: if true;
      allow write: if request.auth != null && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    match /clientes/{rest=**} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && request.resource.size < 200 * 1024 * 1024;
    }
  }
}
