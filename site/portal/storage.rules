rules_version = '2';
// Arquivos (Storage). Só valem depois que o bucket for criado (plano Blaze; veja docs/ATIVACAO-BLAZE.md).
service firebase.storage {
  match /b/{bucket}/o {
    function upe() {
      return request.auth != null && request.auth.token.email_verified == true
        && (request.auth.token.email == 'upecriativo@gmail.com' || request.auth.token.get('upe', false) == true
            || firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)));
    }
    // portal: manual, posts e artes dos clientes (leitura pelo link, envio só pela Upe)
    match /cronograma/{rest=**} {
      allow read: if true;
      allow write: if upe();
    }
    // uma pasta por cliente (nome da marca): dossie (só a Upe) · criacao · paginas/{endereço} · marca · posts · graficos · kits
    match /clientes/{pasta}/{secao}/{rest=**} {
      allow read: if secao != 'dossie' || upe();
      allow write: if upe() && request.resource.size < 200 * 1024 * 1024;
      allow delete: if upe();
    }
    match /clientes/{pasta}/{arquivo} {
      allow read: if true;
      allow write: if upe() && request.resource.size < 200 * 1024 * 1024;
    }
    // Upe TV: vídeos e imagens das campanhas (todas as TVs leem; a gestão envia)
    match /media/{arquivo} {
      allow read: if true;
      allow write: if upe() && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType.matches('(video|image)/.*');
    }
    // dossiês completos (pasta ou .zip): só a Upe envia e lê; o painel mostra pelo link lp.upecriativo.com.br/_d/{chave}/…
    match /dossies/{chave}/{rest=**} {
      allow read, delete: if upe();
      allow write: if upe() && request.resource.size < 200 * 1024 * 1024;
    }
    // páginas e sistemas: imagens do editor (dono da página ou Upe) e, pela Upe, a pasta inteira (HTML, CSS, fontes, scripts, dados)
    match /lp/{slug}/{rest=**} {
      allow read: if true;
      allow write: if (upe() && request.resource.size < 100 * 1024 * 1024)
        || (request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*')
          && request.auth != null && request.auth.token.email_verified == true
          && firestore.get(/databases/(default)/documents/srv_acessos/$(request.auth.uid)).data.cid
             == firestore.get(/databases/(default)/documents/lp_paginas/$(slug)).data.cid);
      allow delete: if upe();
    }
  }
}
