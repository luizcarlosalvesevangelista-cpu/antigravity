rules_version = '2';
// Regras do projeto único da Upe Criativo: portal, Upe ERP e Upe TV.
// Regras do Portal Upe. Admin = usuário com documento em /admins/{uid} (crie no console do Firebase).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function txt(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    // hash SHA-256 do código XXXX-XXXX-XXXX -> id do cliente
    match /codigos/{hash} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }
    // o que o cliente vê; o id é aleatório e só é obtido pelo código
    match /clientes/{id} {
      allow get: if true;
      allow list, write: if isAdmin();
      // ações do cliente: aprovar, pedir ajuste, mensagem, pedido de recompra, pagamento informado
      match /acoes/{acao} {
        allow read: if true;
        allow create: if exists(/databases/$(database)/documents/clientes/$(id))
          && request.resource.data.keys().hasOnly(['tipo', 'alvo', 'versao', 'texto', 'quantidade', 'modo', 'metodo', 'em'])
          && request.resource.data.tipo in ['aprovar', 'ajuste', 'mensagem', 'pedido', 'pagamento']
          && request.resource.data.em is number
          && txt(request.resource.data, 'texto', 4000) && txt(request.resource.data, 'alvo', 64);
        allow update, delete: if isAdmin();
      }
    }
    // dados internos: código, e-mail, telefone, notas e o dossiê completo
    match /privado/{id} { allow read, write: if isAdmin(); }
    // formulário do site
    match /contatos/{c} {
      allow create: if request.resource.data.keys().hasOnly(['nome', 'contato', 'assunto', 'mensagem', 'em', 'status', 'origem'])
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 120
        && request.resource.data.contato is string && request.resource.data.contato.size() <= 160
        && txt(request.resource.data, 'assunto', 60) && txt(request.resource.data, 'mensagem', 4000)
        && request.resource.data.status == 'novo';
      allow read, update, delete: if isAdmin();
    }
    match /config/publico { allow get: if true; allow write: if isAdmin(); }
    match /templates/{t} { allow read, write: if isAdmin(); }
    match /envios/{e} { allow read, write: if isAdmin(); }
    // agenda do admin: reuniões (clientes e leads) e cronograma de postagens da Upe
    match /reunioes/{r} { allow read, write: if isAdmin(); }
    match /cronograma/{c} { allow read, write: if isAdmin(); }
    // fila da extensão "Trigger Email from Firestore"
    match /mail/{m} { allow read, create: if isAdmin(); }
  
    /* ================= Upe ERP (painel, lojas, gestão e página de vendas) ================= */
    function logado() { return request.auth != null; }
    function verificado() { return logado() && request.auth.token.email_verified == true; }
    function ehUpe() { return verificado() && (request.auth.token.email == 'upecriativo@gmail.com' || exists(/databases/$(database)/documents/admins/$(request.auth.uid))); }
    function caminhoAcesso() { return /databases/$(database)/documents/acessos/$(request.auth.uid); }
    function temAcesso() { return verificado() && exists(caminhoAcesso()); }
    function membro(emp) { return ehUpe() || (temAcesso() && get(caminhoAcesso()).data.empresa == emp); }
    function convite() { return get(/databases/$(database)/documents/convites/$(request.auth.token.email)); }

    match /upe/gestao/{doc=**} {
      allow read, write: if ehUpe();
    }
    // textos e cores das páginas editadas no gerenciador (site-lojas, site-painel, site-gestao)
    match /publico/{d} {
      allow read: if d in ['site-lojas', 'site-painel', 'site-gestao'];
      allow write: if ehUpe() && d in ['site-lojas', 'site-painel', 'site-gestao'];
    }
    match /publico/plano {
      allow read: if true;
      allow write: if ehUpe();
    }
    match /publico/vendas/paginas/{slug} {
      allow read: if true;
      allow create: if ehUpe() && request.resource.data.html is string && request.resource.data.html.size() < 1048000;
      allow update, delete: if ehUpe();
    }
    match /empresas/{emp} {
      allow read: if membro(emp);
      allow write: if ehUpe();
      // config/limites (limites do plano) e config/uso (gravado pelo servidor): a empresa só lê; quem grava é a Upe (o servidor ignora as regras)
      match /config/{d} {
        allow read: if membro(emp);
        allow write: if ehUpe() || (membro(emp) && !(d in ['limites', 'uso']));
      }
      match /{col}/{doc=**} {
        allow read, write: if membro(emp) && col != 'config';
      }
    }
    // inbox: a Upe lê os chamados de todas as empresas de uma vez (consulta de grupo)
    match /{caminho=**}/suporte/{id} {
      allow read: if ehUpe();
    }
    match /convites/{email} {
      allow read: if ehUpe() || (verificado() && request.auth.token.email == email);
      allow write: if ehUpe();
    }
    match /acessos/{uid} {
      allow read: if ehUpe() || (logado() && request.auth.uid == uid);
      allow create: if verificado() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/convites/$(request.auth.token.email))
        && request.resource.data.empresa == convite().data.empresa
        && request.resource.data.papel == convite().data.papel
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if ehUpe();
    }
    // lojas/{endereço}: vitrine pública de cada empresa (publicada pelo painel) e pedidos dos compradores
    match /lojas/{slug} {
      function dona() { return membro(get(/databases/$(database)/documents/lojas/$(slug)).data.empresa); }
      allow read: if true;
      allow create: if membro(request.resource.data.empresa);
      allow update: if membro(resource.data.empresa) && request.resource.data.empresa == resource.data.empresa;
      allow delete: if membro(resource.data.empresa);
      match /publico/{d} { allow read: if true; allow write: if dona(); }
      match /produtos/{id} { allow read: if true; allow write: if dona(); }
      match /cupons/{cod} { allow get: if true; allow list, write: if dona(); }
      match /pedidos/{id} {
        allow get: if true;
        allow list, update, delete: if dona();
        allow create: if id.size() >= 12 && exists(/databases/$(database)/documents/lojas/$(slug))
          && request.resource.data.keys().hasOnly(['nome', 'email', 'telefone', 'doc', 'cep', 'endereco', 'numero', 'complemento', 'bairro', 'cidade', 'uf', 'itens', 'sub', 'frete', 'desconto', 'cupom', 'total', 'pagamento', 'parcelas', 'obs', 'status', 'importado', 'criadoEm', 'entrega'])
          && request.resource.data.status == 'novo' && request.resource.data.importado == false
          && request.resource.data.itens is list && request.resource.data.itens.size() > 0 && request.resource.data.itens.size() <= 60
          && request.resource.data.total is number && request.resource.data.total >= 0 && request.resource.data.total < 1000000
          && request.resource.data.nome is string && request.resource.data.nome.size() <= 120
          && request.resource.data.email is string && request.resource.data.email.size() <= 120
          && request.resource.data.obs is string && request.resource.data.obs.size() <= 500;
      }
    }
  
    /* ================= Upe Serviços: Landing pages, Agenda online e Dashboards (painel, páginas públicas, planos e cobranças) ================= */
    function srvAcesso() { return /databases/$(database)/documents/srv_acessos/$(request.auth.uid); }
    function srvMembro(cid) { return ehUpe() || (verificado() && exists(srvAcesso()) && get(srvAcesso()).data.cid == cid); }
    function curto(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    // catálogo de planos (criação e mensalidade) e dados públicos da Upe (PIX, WhatsApp): todos leem, só a Upe edita
    match /srv_planos/{id} { allow read: if true; allow write: if ehUpe(); }
    match /srv_config/{d} { allow read: if true; allow write: if ehUpe(); }
    // interessados vindos das páginas de vendas
    match /srv_interessados/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nome', 'whatsapp', 'email', 'frente', 'plano', 'mensagem', 'origem', 'status', 'criadoEm'])
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 120
        && curto(request.resource.data, 'whatsapp', 40) && curto(request.resource.data, 'email', 120) && curto(request.resource.data, 'frente', 20)
        && curto(request.resource.data, 'plano', 80) && curto(request.resource.data, 'mensagem', 1000) && curto(request.resource.data, 'origem', 200)
        && request.resource.data.status == 'novo';
      allow read, update, delete: if ehUpe();
    }
    match /srv_convites/{email} {
      allow read: if ehUpe() || (verificado() && request.auth.token.email == email);
      allow write: if ehUpe();
    }
    match /srv_acessos/{uid} {
      allow read: if ehUpe() || (logado() && request.auth.uid == uid);
      allow create: if verificado() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/srv_convites/$(request.auth.token.email))
        && request.resource.data.cid == get(/databases/$(database)/documents/srv_convites/$(request.auth.token.email)).data.cid
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if ehUpe();
    }
    match /srv_clientes/{cid} {
      allow read: if srvMembro(cid);
      allow write: if ehUpe();
      match /cobrancas/{id} {
        allow read: if srvMembro(cid);
        allow create, delete: if ehUpe();
        // o cliente só informa que pagou
        allow update: if ehUpe() || (srvMembro(cid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'informadoEm', 'obsCliente'])
          && request.resource.data.status == 'informada' && curto(request.resource.data, 'obsCliente', 500));
      }
      match /chamados/{id} {
        allow read, create, update: if srvMembro(cid);
        allow delete: if ehUpe();
      }
    }
    match /{caminho=**}/cobrancas/{id} { allow read: if ehUpe(); }
    match /{caminho=**}/chamados/{id} { allow read: if ehUpe(); }
    // páginas: o documento guarda a versão publicada; o rascunho fica em privado/rascunho
    match /lp_paginas/{slug} {
      function lpDono() { return srvMembro(get(/databases/$(database)/documents/lp_paginas/$(slug)).data.cid); }
      allow get: if resource == null || (resource.data.publicada == true && resource.data.get('suspensa', false) == false) || srvMembro(resource.data.cid);
      allow list: if srvMembro(resource.data.cid);
      allow create: if srvMembro(request.resource.data.cid) && (ehUpe() || request.resource.data.get('suspensa', false) == false)
        && slug.matches('^[a-z0-9][a-z0-9-]{1,47}$') && request.resource.data.html is string && request.resource.data.html.size() < 900000;
      allow update: if ehUpe() || (srvMembro(resource.data.cid) && request.resource.data.cid == resource.data.cid
        && request.resource.data.get('suspensa', false) == resource.data.get('suspensa', false)
        && request.resource.data.html is string && request.resource.data.html.size() < 900000);
      allow delete: if srvMembro(resource.data.cid);
      match /privado/{d} { allow read, write: if lpDono(); }
      match /versoes/{id} { allow read, create, delete: if lpDono(); }
      match /eventos/{id} {
        allow create: if request.resource.data.keys().hasOnly(['tipo', 't', 'vid', 'ref', 'utm', 'disp', 'alvo', 'prof'])
          && request.resource.data.tipo in ['visita', 'clique', 'lead', 'rolagem', 'whatsapp']
          && request.resource.data.t is int && curto(request.resource.data, 'vid', 40) && curto(request.resource.data, 'ref', 200)
          && curto(request.resource.data, 'utm', 200) && curto(request.resource.data, 'disp', 20) && curto(request.resource.data, 'alvo', 200);
        allow read, delete: if lpDono();
      }
      match /leads/{id} {
        allow create: if request.resource.data.keys().hasOnly(['campos', 't', 'vid', 'utm', 'status'])
          && request.resource.data.campos is map && request.resource.data.campos.size() <= 20 && request.resource.data.t is int && request.resource.data.status == 'novo';
        allow read, update, delete: if lpDono();
      }
    }
    // domínios próprios: o cliente pede, a Upe conecta no Hosting e marca como ativo
    match /lp_dominios/{host} {
      allow get: if resource == null || resource.data.status == 'ativo' || srvMembro(resource.data.cid);
      allow list: if srvMembro(resource.data.cid);
      allow create: if srvMembro(request.resource.data.cid) && (ehUpe() || request.resource.data.status == 'pendente') && host.matches('^[a-z0-9.-]{4,120}$');
      allow update: if ehUpe();
      allow delete: if srvMembro(resource.data.cid);
    }
    // agenda online: configuração pública, horários ocupados públicos (sem dados pessoais) e reservas privadas
    match /agenda_paginas/{slug} {
      function agDono() { return srvMembro(get(/databases/$(database)/documents/agenda_paginas/$(slug)).data.cid); }
      allow read: if true;
      allow create: if srvMembro(request.resource.data.cid) && slug.matches('^[a-z0-9][a-z0-9-]{1,47}$');
      allow update: if srvMembro(resource.data.cid) && request.resource.data.cid == resource.data.cid;
      allow delete: if srvMembro(resource.data.cid);
      match /slots/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['data', 'hora', 'r'])
          && id == request.resource.data.data + '_' + request.resource.data.hora
          && get(/databases/$(database)/documents/agenda_paginas/$(slug)).data.ativo == true;
        allow delete: if agDono();
      }
      match /reservas/{id} {
        allow create: if existsAfter(/databases/$(database)/documents/agenda_paginas/$(slug)/slots/$(id))
          && request.resource.data.keys().hasOnly(['servico', 'data', 'hora', 'dur', 'nome', 'telefone', 'email', 'obs', 'status', 't', 'slots'])
          && request.resource.data.status == 'nova' && request.resource.data.nome is string && request.resource.data.nome.size() <= 120
          && curto(request.resource.data, 'telefone', 40) && curto(request.resource.data, 'email', 120) && curto(request.resource.data, 'obs', 500);
        allow read, update, delete: if agDono();
      }
    }
    // dashboards montados pela Upe para o cliente
    match /dash_paineis/{id} {
      allow read: if srvMembro(resource.data.cid);
      allow write: if ehUpe();
    }

    /* ================= Upe TV (campanhas, telas e player) ================= */
    function tvLogado() { return request.auth != null; }
    function tvAdmin() {
      return tvLogado() && request.auth.token.firebase.sign_in_provider == 'password'
        && (request.auth.token.email in ['upecriativo@gmail.com'] || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    // Configuração (campanhas, telas, anunciantes, páginas CTA) e imagens de produto: todos leem, só admin publica.
    match /app/{doc} { allow read: if true; allow write: if tvAdmin(); }
    match /img/{doc} { allow read: if true; allow write: if tvAdmin(); }
    // Tempo de tela enviado pelas TVs.
    match /plays/{doc} {
      allow read: if tvLogado();
      allow create, update: if tvLogado() && request.resource.data.screen is string && request.resource.data.date is string;
      allow delete: if tvAdmin();
    }
    // Leituras de QR, visitas e pedidos enviados pelos celulares.
    match /events/{doc} {
      allow read: if tvLogado();
      allow create: if tvLogado() && request.resource.data.type in ['scan', 'continue', 'cta_view', 'cta_click', 'order'];
      allow update, delete: if tvAdmin();
    }
  }
}
